# Mock REST API configuration
API_BASE_URL=http://127.0.0.1:8000

# DuckDB warehouse storage path
DB_PATH=data/warehouse.duckdb

# AI summary provider: 'rule_based' (default, offline) or 'ollama' (local LLM)
SUMMARY_PROVIDER=rule_based

# Ollama settings (used when SUMMARY_PROVIDER=ollama)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Extraction retry and timeout policies
MAX_RETRIES=3
REQUEST_TIMEOUT_SECONDS=10
